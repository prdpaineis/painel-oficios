# Copie para .env e preencha (não vai para o git). Em CI (GitHub Actions),
# use os secrets do repositório em vez de um arquivo — ver .github/workflows/atualizar-painel.yml.

ODOO_URL=https://SEU-HOST-ODOO
ODOO_DB=SEU_BANCO
ODOO_LOGIN=agente.escritorio
ODOO_API_KEY=

